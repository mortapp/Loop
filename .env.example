# LOOP ENVIRONMENT TEMPLATE
# DO NOT PUT REAL SECRETS IN THIS FILE

SUPABASE_URL=
SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- apps/web (Next.js) ---
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY above are
# also what apps/web reads directly (client-safe, NEXT_PUBLIC_*:
# inlined into the browser bundle). The Supabase anon key is designed
# to be public — RLS in the database is the real security boundary,
# not secrecy of this key. See docs/VERCEL_DEPLOYMENT.md for the full
# rationale.

# Base URL used to build absolute links (e.g. Supabase Auth redirect/
# callback URLs) from server code and metadata. Must differ per
# environment — localhost in dev, the Vercel-provided preview URL
# (`https://${VERCEL_URL}`) in preview deployments, and a future custom
# domain in production. Never hardcode a URL in application code —
# always read it from this env var. See docs/VERCEL_DEPLOYMENT.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- apps/web AI (Phase 8) ---
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_. Unlike the Supabase
# anon key, this key must never reach the browser bundle.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5 if unset — see apps/web/src/lib/ai/client.ts.
ANTHROPIC_MODEL=

# Server-only values belong in local environment configuration.
# Never commit privileged/service-role credentials.

# --- apps/web E2E (Playwright, Phase 4 test infra) ---
# A dedicated, isolated Supabase Auth account used only for E2E test runs
# -- never a real user's credentials, never the production auth bypass.
# Tests that need a signed-in session skip themselves when these are
# unset (see apps/web/playwright.config.ts / e2e/auth.setup.ts). In CI
# these come from repo secrets, never from a committed file. See
# docs/KNOWN_ISSUES.md for the OWNER_ACTION_REQUIRED entry tracking
# provisioning this account.
QA_TEST_EMAIL=
QA_TEST_PASSWORD=
