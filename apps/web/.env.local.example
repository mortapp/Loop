# Next.js only loads .env.local from this directory (apps/web), not the
# repo root — copy this to .env.local and fill it in. See the root
# .env.example for the canonical list of LOOP env vars and what each
# one is for.
#
# For local development against the LOOP Supabase stack (`supabase start`
# from the repo root), run `supabase status -o env` and copy API_URL /
# ANON_KEY from there.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
